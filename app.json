{
  "expo": {
    "scheme": "ludora",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1095759943103-dtv50sdakgk0dbf2s3rqd9rd4g3nh88j"
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à accéder à votre position."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ludora",
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logos/app-icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ]
    ],
    "name": "ludora",
    "slug": "ludora",
    "icon": "./assets/logos/app-icon.png",
    "android": {
      "package": "com.amir398.ludora",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.amir398.ludora",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f64eb375-d990-44a8-9a85-40fc096e2def"
      }
    }
  }
}

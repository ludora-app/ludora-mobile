{
  "expo": {
    "scheme": "ludora",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1095759943103-dtv50sdakgk0dbf2s3rqd9rd4g3nh88j"
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à accéder à votre position."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ludora",
          "enableGooglePay": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFEEE5",
          "image": "./assets/logos/big-logo.png",
          "dark": {
            "image": "./assets/logos/big-logo.png",
            "backgroundColor": "#FFEEE5"
          },
          "imageWidth": 100
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-asset"
    ],
    "name": "ludora",
    "slug": "ludora",
    "icon": "./assets/logos/app-icon.png",
    "android": {
      "package": "com.amir398.ludora",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.amir398.ludora"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "91b4169f-5883-4899-8b2b-eade1e82b68b"
      }
    }
  }
}

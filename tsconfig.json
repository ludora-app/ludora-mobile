{
  "compilerOptions": {
    "strict": true,
    "paths": {
      "assets": ["./assets"],
      "@/*": ["./src/*"],
      "@ludo/ui": ["./src/components/ludo-ui"],
      "@chillui/ui": ["./src/components/chill-ui-library"],
      "@features/*": ["./src/features/*"],
      "@api/*": ["./src/api/*"],
      "@generatedApi/*": ["./src/api/generated/api/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "app.config.ts",
    "orval.config.ts"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/hooks/geolocalisation.hookts",
    "src/features/filters/filters-calendar",
    "src/utils/api-url.utils.ts",
    "tools/generate-api/api-url.utils.js",
    "src/components/ludo-ui/components/list/utils/index.tsw",
    "src/features/create-session/screens/creat-session-step-1.screen.tsW",
    "src/features/players/screens/players.screen.tsw",
    "src/initializers/push-notifications.initializer.txs",
    "src/constants/icons.constants.ts",
    "src/initializers/on-boarding/on-boarding-status.initializertsx"
  ]
}

{
  "expo": {
    "version": "true",
    "owner": "ludora-app",
    "scheme": "ludora",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "web": {
      "output": "static"
    },
    "plugins": [
      "./tools/firebase-fix/firebase-messaging-fix",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1095759943103-dtv50sdakgk0dbf2s3rqd9rd4g3nh88j"
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à accéder à votre position."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ludora",
          "enableGooglePay": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFEEE5",
          "image": "./assets/logos/big-logo.png",
          "dark": {
            "image": "./assets/logos/big-logo.png",
            "backgroundColor": "#FFEEE5"
          },
          "imageWidth": 100
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à tes photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logos/app-icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset",
      "@react-native-firebase/app",
      "./plugins/with-non-modular-headers",
      "./plugins/with-android-manifest-fixes"
    ],
    "name": "Ludora",
    "slug": "ludora",
    "icon": "./assets/logos/app-icon.png",
    "android": {
      "package": "com.ludora",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ludora.fr",
              "pathPrefix": "/profil"
            },
            {
              "scheme": "https",
              "host": "www.ludora.fr",
              "pathPrefix": "/profil"
            },
            {
              "scheme": "https",
              "host": "ludora.fr",
              "pathPrefix": "/session"
            },
            {
              "scheme": "https",
              "host": "www.ludora.fr",
              "pathPrefix": "/session"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 0
    },
    "ios": {
      "bundleIdentifier": "com.ludora",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1.0.3-alpha.6"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f64eb375-d990-44a8-9a85-40fc096e2def"
      }
    }
  }
}

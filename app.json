{
  "expo": {
    "owner": "ludora-app",
    "scheme": "ludora",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "web": {
      "output": "static"
    },
    "plugins": [
      "./tools/firebase-fix/firebase-messaging-fix",
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à accéder à votre position."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ludora",
          "enableGooglePay": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFEEE5",
          "image": "./assets/logos/ic-launcher-ios.png",
          "dark": {
            "image": "./assets/logos/ic-launcher-ios.png",
            "backgroundColor": "#FFEEE5"
          },
          "imageWidth": 130
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à tes photos.",
          "cameraPermission": "L'application a besoin d'accéder à ta caméra."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logos/ic-np-icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset",
      "@react-native-firebase/app",
      "./plugins/with-non-modular-headers",
      "./plugins/with-android-manifest-fixes"
    ],
    "name": "Ludora",
    "slug": "ludora",
    "icon": "./assets/logos/ic-launcher-ios.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logos/ic-launcher-android.png",
        "backgroundColor": "#FFEEE5"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ludora.fr",
              "pathPrefix": "/profil"
            },
            {
              "scheme": "https",
              "host": "www.ludora.fr",
              "pathPrefix": "/profil"
            },
            {
              "scheme": "https",
              "host": "ludora.fr",
              "pathPrefix": "/session"
            },
            {
              "scheme": "https",
              "host": "www.ludora.fr",
              "pathPrefix": "/session"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "icon": "./assets/logos/ic-launcher-ios.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:ludora.fr", "applinks:www.ludora.fr"]
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f64eb375-d990-44a8-9a85-40fc096e2def"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f64eb375-d990-44a8-9a85-40fc096e2def"
    }
  }
}
